# Copy this file to .env.local and fill in the values.
# .env.local is gitignored. Never commit a real secret.
# FRD section 7 is the source of truth for this list.

# Neon Postgres (pooled connection string)
DATABASE_URL=

# Auth.js v5. Generate AUTH_SECRET with: openssl rand -base64 33
AUTH_SECRET=

# Google Cloud Console, OAuth client of type Web
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Mailgun HTTP API. EU accounts use https://api.eu.mailgun.net
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_API_BASE=https://api.mailgun.net
MAIL_FROM="Jaynie's Collection <orders@YOUR_MAILGUN_DOMAIN>"

# Set to the production URL on Vercel. Never hard-code localhost in code.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Public brand contact details
NEXT_PUBLIC_WHATSAPP_NUMBER=2348000000000
NEXT_PUBLIC_INSTAGRAM_HANDLE=jayniescollection

# Uncomment only if Auth.js cannot detect the host (for example behind a proxy).
# AUTH_TRUST_HOST=true