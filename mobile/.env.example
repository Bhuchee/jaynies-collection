# The deployed Jaynie's Collection site. This is a PUBLIC url, not a secret.
#
# Never use localhost here: a physical phone cannot reach a laptop on :3000, and
# AGENTS.md rule 7 forbids hard-coding a host. Copy this file to mobile/.env and
# put the Vercel url in it. mobile/.env is gitignored and must never be committed.
EXPO_PUBLIC_API_URL=https://YOUR-VERCEL-DOMAIN